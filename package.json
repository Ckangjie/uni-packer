{
  "name": "uniapp-pack-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "electron:dev": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "pack:exe": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "sass": "^1.77.0",
    "unocss": "^66.11.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.boil.uniapppackdesktop",
    "productName": "UniOfflinePack",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false,
      "artifactName": "UniOfflinePack.exe"
    }
  }
}
